# ============================================
# LiveCV Backend Environment Configuration - CORS FIX
# ============================================
# Copy these settings to your .env file

# -----------------
# Server Configuration
# -----------------
PORT=5001
NODE_ENV=development

# -----------------
# Frontend URL (CORS) - IMPORTANT: Match your frontend URL exactly
# -----------------
# Note: Common Vite ports are 5173 or 5172
# Check your frontend terminal to see which port it's using
FRONTEND_URL=http://localhost:5173

# -----------------
# Appwrite Configuration
# -----------------
# Get these from https://cloud.appwrite.io
# ⚠️ CRITICAL: To fix 400 Bad Request errors:
#    1. Go to Appwrite Console → Your Project
#    2. Click "Add Platform" → Select "Web App"
#    3. Set Hostname to: localhost (no http:// or port number)
#    4. This allows ALL localhost ports (5172, 5173, etc.)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=your_project_id_here
APPWRITE_API_KEY=your_api_key_here
APPWRITE_DATABASE_ID=livecv-production

# -----------------
# Session Security
# -----------------
SESSION_SECRET=your_very_secure_session_secret_here_please_change_this
