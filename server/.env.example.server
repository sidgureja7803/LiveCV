# ============================================
# LiveCV Server Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# -----------------
# Server Configuration (REQUIRED)
# -----------------
# Port number for the Express server
PORT=5001

# Environment mode: development, production, or test
NODE_ENV=production

# -----------------
# Frontend URL (REQUIRED for CORS)
# -----------------
# URL where your frontend is hosted
# Development: http://localhost:5173
# Production: https://your-app.netlify.app
FRONTEND_URL=http://localhost:5173

# -----------------
# Appwrite Configuration (REQUIRED)
# -----------------
# Get these from: https://cloud.appwrite.io/console

# Appwrite API endpoint (usually cloud.appwrite.io for cloud version)
APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (found in Project Settings)
APPWRITE_PROJECT_ID=your-project-id-here

# Appwrite API key with required scopes:
# - databases.* (read, write, delete)
# - storage.* (read, write, delete)
# - users.read
# Generate from: Project Settings > API Keys
APPWRITE_API_KEY=your-api-key-here

# -----------------
# Appwrite Database Configuration (REQUIRED)
# -----------------
# Database ID (create in Appwrite Console > Databases)
APPWRITE_DATABASE_ID=livecv-production

# Collection IDs (create these collections in your database)
# Collection: resumes - stores resume metadata
APPWRITE_COLLECTION_RESUMES=resumes

# Collection: users - stores additional user data
APPWRITE_COLLECTION_USERS=users

# -----------------
# Appwrite Storage Configuration (REQUIRED)
# -----------------
# Storage bucket IDs (create in Appwrite Console > Storage)

# Bucket for storing generated PDF files
APPWRITE_BUCKET_PDFS=resume-pdfs

# Bucket for storing YAML source files
APPWRITE_BUCKET_YAMLS=resume-yamls

# -----------------
# AI/ML API Configuration (OPTIONAL)
# -----------------
# AIML API key for AI-powered features (ATS scoring, job matching)
# Get from: https://aimlapi.com
# If not provided, AI features will be disabled
AIMLAPI_API_KEY=your-aiml-api-key-here

# OpenAI API key for additional AI features (optional)
# Get from: https://platform.openai.com/api-keys
# If not provided, OpenAI-specific features will be disabled
OPENAI_API_KEY=sk-your-openai-key-here

# -----------------
# Notes
# -----------------
# 1. All REQUIRED variables must be set for the application to work
# 2. OPTIONAL variables enable additional features but aren't critical
# 3. Keep your .env file secure and never commit it to git
# 4. Update FRONTEND_URL to match your actual frontend deployment URL
# 5. Ensure Appwrite bucket IDs match the actual bucket IDs in your Appwrite project
