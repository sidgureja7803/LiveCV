import React, { useState, useEffect } from 'react';
import { useNavigate } from 'react-router-dom';
import { useAuth } from '../contexts/AuthContext';
import { useTheme } from '../contexts/ThemeContext';
import { FileText, Zap, Award, Shield, ArrowRight, CheckCircle, Sun, Moon, Sparkles, Download, Eye } from 'lucide-react';

const Landing: React.FC = () => {
  const navigate = useNavigate();
  const { isAuthenticated } = useAuth();
  const { isDark, toggleTheme } = useTheme();
  const [isScrolled, setIsScrolled] = useState(false);

  // Handle scroll for navbar background
  useEffect(() => {
    const handleScroll = () => {
      setIsScrolled(window.scrollY > 20);
    };
    window.addEventListener('scroll', handleScroll);
    return () => window.removeEventListener('scroll', handleScroll);
  }, []);

  // Available templates from server/templates folder
  const templates = [
    { name: 'Classic Theme', file: 'John_Doe_ClassicTheme_CV.pdf', description: 'Clean and professional' },
    { name: 'Engineering Classic', file: 'John_Doe_EngineeringclassicTheme_CV.pdf', description: 'Perfect for engineers' },
    { name: 'Engineering Resumes', file: 'John_Doe_EngineeringresumesTheme_CV.pdf', description: 'Tech-focused design' },
    { name: 'Modern CV', file: 'John_Doe_ModerncvTheme_CV.pdf', description: 'Modern and stylish' },
    { name: 'Sb2nov Theme', file: 'John_Doe_Sb2novTheme_CV.pdf', description: 'Compact layout' }
  ];

  // Real company logos (text-based professional version)
  const companies = [
    { name: 'Google', color: 'from-blue-600 to-green-600' },
    { name: 'Microsoft', color: 'from-blue-600 to-blue-400' },
    { name: 'Amazon', color: 'from-orange-600 to-yellow-500' },
    { name: 'Apple', color: 'from-gray-700 to-gray-900' },
    { name: 'Meta', color: 'from-blue-600 to-indigo-600' },
    { name: 'Netflix', color: 'from-red-600 to-red-800' },
    { name: 'Tesla', color: 'from-red-600 to-gray-900' },
    { name: 'IBM', color: 'from-blue-700 to-blue-900' }
