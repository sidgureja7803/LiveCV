# ============================================
# LiveCV Client Environment Configuration
# ============================================
# Copy this file to .env and fill in your actual values
# NEVER commit the actual .env file to version control

# -----------------
# API Configuration (REQUIRED)
# -----------------
# Backend API URL
# Development: http://localhost:5001
# Production: https://your-api-server.com
VITE_API_URL=http://localhost:5001

# -----------------
# Appwrite Configuration (REQUIRED)
# -----------------
# These values must match your server configuration
# Get these from: https://cloud.appwrite.io/console

# Appwrite API endpoint (must match server APPWRITE_ENDPOINT)
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1

# Your Appwrite project ID (must match server APPWRITE_PROJECT_ID)
VITE_APPWRITE_PROJECT_ID=your-project-id-here

# Database ID (must match server APPWRITE_DATABASE_ID)
VITE_APPWRITE_DATABASE_ID=livecv-production

# -----------------
# Development Key (OPTIONAL - Development Only)
# -----------------
# API key for development/testing purposes
# WARNING: Never use this in production!
# Only needed for local development if you want to bypass auth
# VITE_APPWRITE_DEV_KEY=your-dev-key-here

# -----------------
# Notes
# -----------------
# 1. All VITE_ prefixed variables are exposed to the browser
# 2. Never put sensitive secrets in client environment variables
# 3. Ensure all Appwrite values match between client and server
# 4. Update VITE_API_URL to point to your deployed backend in production
# 5. Remove or comment out VITE_APPWRITE_DEV_KEY in production builds
