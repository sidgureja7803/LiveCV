# ============================================
# LiveCV Frontend Environment Configuration
# ============================================
# Copy this file to .env and fill in your values

# -----------------
# API Configuration
# -----------------
VITE_API_URL=http://localhost:5001

# -----------------
# Appwrite Configuration
# -----------------
# Get these from https://cloud.appwrite.io
# ⚠️ IMPORTANT: Add "localhost" as a Web Platform in Appwrite Console
#    Go to: Project Settings → Platforms → Add Platform → Web App → Hostname: localhost
VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your_project_id_here
VITE_APPWRITE_DATABASE_ID=livecv-production
